# Staging environment for the Hetzner box. Copy to deploy/.env.staging and fill
# in real values. NEVER commit deploy/.env.staging. Generate secrets with:
#   openssl rand -hex 32
# DB/Redis hostnames are the docker-compose service names (postgres / redis).

APP_ENV=staging
NODE_ENV=production
LOG_LEVEL=info

# --- Hostnames for Caddy TLS (no scheme) ---
APP_HOST=app.example.com
ARTICLE_HOST=articles.example.com
# NOTE: there is no REDIRECT_HOST — the redirect (go.*) is the Cloudflare Worker
# (apps/redirect/worker.ts), not an origin service, so Caddy doesn't serve it.
# Optional extra article host on a Google-approved domain for live AFS testing
# (Caddy serves it from the article app + issues TLS). Leave unset if not used.
AFS_TEST_HOST=

# --- Article frontend + AFS (AdSense for Search) ---
# Server-side base the article SSR fetches the public article API from (internal
# docker network address is fastest).
ARTICLE_API_BASE=http://api:3000
# AFS pubId (partner-pub-...) + style. NEXT_PUBLIC_* → baked into the article
# build (build args), so a rebuild is needed to change them. Ads only serve on
# Google-approved domains; leave empty otherwise.
NEXT_PUBLIC_AFS_PUB_ID=
NEXT_PUBLIC_AFS_STYLE_ID=
# "on" = AFS test mode (no impressions/clicks/revenue) while validating; empty in prod.
NEXT_PUBLIC_AFS_ADTEST=
# Ad filtering: low | medium | high (defaults to medium). Arbitrage funnels run low/medium.
NEXT_PUBLIC_AFS_ADSAFE=

# --- Full URLs for the app (OAuth redirects, link building) ---
PLATFORM_DOMAIN=https://app.example.com
WEB_DOMAIN=https://app.example.com
ARTICLE_DOMAIN=https://articles.example.com
# Points at the Cloudflare Worker host (go.*) — used to build per-ad FB creative
# links (${REDIRECT_DOMAIN}/go/{id}). Served by the edge Worker, not this origin.
REDIRECT_DOMAIN=https://go.example.com

# --- Internal ports (Caddy proxies to these) ---
API_PORT=3000
ARTICLE_PORT=3001
WEB_PORT=3003

# --- PostgreSQL (service name: postgres) ---
POSTGRES_USER=knn
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=knn
# Owner/superuser connection (migrations + role bootstrap). Password must match POSTGRES_PASSWORD.
DATABASE_URL=postgresql://knn:CHANGE_ME_strong_db_password@postgres:5432/knn?schema=public
# App runtime role (NON-superuser, RLS-enforced). Its password is set by db:bootstrap from this URL.
APP_DATABASE_URL=postgresql://knn_app:CHANGE_ME_strong_app_password@postgres:5432/knn?schema=public

# --- Redis (service name: redis) ---
REDIS_URL=redis://redis:6379

# --- Auth / crypto (generate each with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=CHANGE_ME_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_hex_32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Must be exactly 64 hex chars (32 bytes).
TOKEN_ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# --- Bull-Board (queue dashboard) basic auth ---
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=CHANGE_ME

# --- First-boot super admin (seed) ---
SEED_SUPERADMIN_EMAIL=you@yourdomain.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_strong

# --- Facebook (STAGING USES TEST AD ACCOUNTS — never prod) ---
FB_APP_ID=
FB_APP_SECRET=
FB_API_VERSION=v21.0
FB_OAUTH_REDIRECT_URI=https://app.example.com/api/facebook/callback
# Facebook Login for Business: the login-configuration id (from the app dashboard).
# Leave blank to use classic scope-based Facebook Login instead.
FB_LOGIN_CONFIG_ID=
FB_WEBHOOK_VERIFY_TOKEN=CHANGE_ME

# --- Google AdSense ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://app.example.com/api/adsense/callback

# --- AI providers ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Cloudflare KV (edge redirect Worker config sync) ---
# The API writes per-ad redirect configs to the Worker's KV namespace at launch.
# Token needs "Workers KV Storage: Edit". Empty = skip the sync (logs a warning).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CF_KV_NAMESPACE_ID=

# --- Internal worker -> API trigger (auto-launch, D19) ---
# When a company has auto-launch on, the worker calls the API's internal launch
# endpoint. INTERNAL_API_TOKEN is a shared secret (openssl rand -hex 32); the URL is
# the API on the internal docker network. Empty token disables the auto-launch trigger.
INTERNAL_API_TOKEN=
INTERNAL_API_URL=http://api:3000

# --- FX rates ---
FX_API_URL=https://api.exchangerate.host
FX_API_KEY=

# --- Storage / business ---
UPLOAD_DIR=/repo/var/uploads
BUSINESS_TIMEZONE=Asia/Kolkata
