# Caddy auto-provisions TLS (Let's Encrypt) for each domain. Requires public DNS
# pointing the domains at this box and ports 80/443 reachable. Domains come from
# .env.staging (APP_DOMAIN / ARTICLE_DOMAIN / REDIRECT_DOMAIN — hostnames only,
# no scheme). If Cloudflare proxying is on, use "Full (strict)" SSL mode.

{$APP_HOST} {
	# Internal worker→API routes (Phase 8 auto-launch, D19) must NOT be reachable from
	# the public edge — the worker calls them on the internal Docker network (api:3000),
	# never through Caddy. They're token-guarded, but block them here too (defense in
	# depth). This handle is first, so it wins for /api/internal before the /api/* proxy.
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 403
	}

	# API + admin (incl. Bull-Board at /admin/queues) → Fastify; everything else → dashboard.
	@api path /api/* /admin/*
	handle @api {
		reverse_proxy api:3000
	}
	handle {
		reverse_proxy web:3003
	}
	encode gzip zstd
}

{$ARTICLE_HOST} {
	reverse_proxy article:3001
	encode gzip zstd
}

# Extra article host on a Google-approved domain for live AFS testing. Defaults to
# an internal localhost address when AFS_TEST_HOST is unset, so deploys that don't
# use it aren't affected (Caddy won't try to issue a public cert for it).
{$AFS_TEST_HOST:localhost:8081} {
	reverse_proxy article:3001
	encode gzip zstd
}

# NOTE: the redirect domain (go.*) is served by the Cloudflare Worker
# (apps/redirect/worker.ts), NOT this origin — there is intentionally NO redirect
# host block here. Retiring it (task #18) means a stray route flip to the box fails
# loud (no cert/host) instead of silently serving unmonetized 302s.
