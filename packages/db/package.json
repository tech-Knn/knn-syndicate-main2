{
  "name": "@knn/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "bootstrap": "dotenv -e ../../.env -- tsx scripts/bootstrap-roles.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "gen:demo-articles": "dotenv -e ../../.env -- tsx scripts/generate-demo-articles.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run --passWithNoTests"
  },
  "dependencies": {
    "@knn/ai": "workspace:*",
    "@knn/config": "workspace:*",
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.10",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^8.0.0",
    "pg": "^8.13.1",
    "prisma": "^6.2.1"
  }
}
