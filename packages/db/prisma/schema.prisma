// KNN Search Arbitrage Platform — Prisma schema.
// Phase 1 adds multi-tenancy (organizations + users + auth) with Postgres RLS.
// Later phases add campaigns, adsets, ads, channels, articles, revenue, etc.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MEDIA_BUYER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum FbConnectionStatus {
  ACTIVE
  CONNECTION_BROKEN
}

/// A tenant company. The platform operator (KNN) is the single `isPlatform` org
/// that SUPER_ADMINs belong to; every other org is a client company.
model Organization {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String    @unique
  status               OrgStatus @default(ACTIVE)
  isPlatform           Boolean   @default(false) @map("is_platform")
  /// Platform's default revenue cut for this org's buyers (0..1).
  defaultRevenueCutPct Decimal   @default(0.30) @map("default_revenue_cut_pct") @db.Decimal(5, 4)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  users     User[]
  campaigns Campaign[]

  @@map("organizations")
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  email         String      @unique
  passwordHash  String      @map("password_hash")
  name          String
  role          Role        @default(MEDIA_BUYER)
  status        UserStatus  @default(PENDING)
  /// Optional per-buyer override of the org's default revenue cut (0..1).
  revenueCutPct Decimal?    @map("revenue_cut_pct") @db.Decimal(5, 4)
  /// Account-level fallback URL for non-ad traffic (spec §5.7.5).
  fallbackUrl   String?     @map("fallback_url")
  approvedById  String?     @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?   @map("approved_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  fbConnection  FbConnection?
  campaigns     Campaign[]

  @@index([orgId, status])
  @@map("users")
}

/// A media buyer's connected Facebook account (one per user). The long-lived
/// user access token (~60d) is stored encrypted at rest (AES-256-GCM).
model FbConnection {
  id             String             @id @default(uuid()) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  userId         String             @unique @map("user_id") @db.Uuid
  fbUserId       String             @map("fb_user_id")
  accessTokenEnc String             @map("access_token_enc")
  tokenExpiresAt DateTime           @map("token_expires_at")
  scopes         String             @default("")
  status         FbConnectionStatus @default(ACTIVE)
  lastError      String?            @map("last_error")
  connectedAt    DateTime           @default(now()) @map("connected_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccounts FbAdAccount[]
  pages      FbPage[]

  @@index([orgId, status])
  @@index([status, tokenExpiresAt])
  @@map("fb_connections")
}

model FbAdAccount {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  fbAccountId  String   @map("fb_account_id")
  name         String
  currency     String
  timezone     String
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  connection FbConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  pixels     FbPixel[]

  @@unique([connectionId, fbAccountId])
  @@index([orgId])
  @@map("fb_ad_accounts")
}

model FbPage {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  fbPageId     String   @map("fb_page_id")
  name         String
  instagramId  String?  @map("instagram_id")
  createdAt    DateTime @default(now()) @map("created_at")

  connection FbConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, fbPageId])
  @@index([orgId])
  @@map("fb_pages")
}

model FbPixel {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  adAccountId  String   @map("ad_account_id") @db.Uuid
  fbPixelId    String   @map("fb_pixel_id")
  name         String
  landerEvent  String?  @map("lander_event")
  searchEvent  String?  @map("search_event")
  adclickEvent String?  @map("adclick_event")
  createdAt    DateTime @default(now()) @map("created_at")

  adAccount FbAdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, fbPixelId])
  @@index([orgId])
  @@map("fb_pixels")
}

/// Hashed refresh tokens for JWT rotation (access 15m / refresh 7d).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Append-only audit trail of privileged actions.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String?  @map("org_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@map("audit_log")
}

/// Global key/value platform settings (compliance prompt, feature toggles, ...).
/// Column names kept as originally migrated (camelCase) to avoid a destructive
/// rename of already-seeded rows.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Phase 3 — Ad launcher. Campaign = the "offer" (D5/D6/D7): keywords, RAC, the
// single article, and the AdSense channel live at CAMPAIGN level; ads are
// creative variations. Per-ad redirect_id (D9) + selectable pxe (D10).
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  LAUNCHING
  ACTIVE
  PAUSED
  REJECTED
  BATCHED
  QUEUED_NO_CHANNEL
  META_REJECTED
  ARCHIVED
}

enum CampaignObjective {
  OUTCOME_SALES
  OUTCOME_LEADS
  OUTCOME_TRAFFIC
  OUTCOME_ENGAGEMENT
  OUTCOME_AWARENESS
  OUTCOME_APP_PROMOTION
}

enum AdCreativeType {
  IMAGE
  VIDEO
}

model Campaign {
  id               String            @id @default(uuid()) @db.Uuid
  orgId            String            @map("org_id") @db.Uuid
  buyerId          String            @map("buyer_id") @db.Uuid
  name             String
  status           CampaignStatus    @default(DRAFT)
  objective        CampaignObjective @default(OUTCOME_SALES)
  optimizationGoal String            @default("OFFSITE_CONVERSIONS") @map("optimization_goal")

  /// Campaign-level offer config (D5): keywords array + Related Ad Category + fallback.
  keywords    Json    @default("[]")
  racValue    String? @map("rac_value")
  fallbackUrl String? @map("fallback_url")

  /// Selected Facebook assets — scalar refs to fb_* rows, validated in the service
  /// layer (no FK so disconnect-churn of fb assets can't cascade-delete campaigns).
  adAccountId String? @map("ad_account_id") @db.Uuid
  pageId      String? @map("page_id") @db.Uuid

  /// Wired in later phases: article (Phase 5) and AdSense channel (Phase 6).
  articleId String? @map("article_id") @db.Uuid
  channelId String? @map("channel_id") @db.Uuid

  /// Populated on launch (Phase 8).
  fbCampaignId String? @map("fb_campaign_id")

  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  buyer        User         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  adSets       AdSet[]

  @@index([orgId, status])
  @@index([buyerId])
  @@map("campaigns")
}

model AdSet {
  id               String    @id @default(uuid()) @db.Uuid
  orgId            String    @map("org_id") @db.Uuid
  campaignId       String    @map("campaign_id") @db.Uuid
  name             String
  /// Daily budget in minor units (cents) of the ad-account currency. Money = integer cents.
  dailyBudgetCents Int       @map("daily_budget_cents")
  billingEvent     String    @default("IMPRESSIONS") @map("billing_event")
  optimizationGoal String    @default("OFFSITE_CONVERSIONS") @map("optimization_goal")
  /// FB targeting spec (geo / age / gender / interests).
  targeting        Json      @default("{}")
  startTime        DateTime? @map("start_time")
  endTime          DateTime? @map("end_time")
  fbAdSetId        String?   @map("fb_ad_set_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@index([orgId])
  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id           String         @id @default(uuid()) @db.Uuid
  orgId        String         @map("org_id") @db.Uuid
  adSetId      String         @map("ad_set_id") @db.Uuid
  name         String
  /// Creative.
  headline     String
  primaryText  String         @map("primary_text")
  description  String?
  cta          String         @default("LEARN_MORE")
  creativeType AdCreativeType @default(IMAGE) @map("creative_type")
  uploadId     String?        @map("upload_id") @db.Uuid

  /// Per-ad cloaked redirect (D9) — unique link FB targets; resolves ad -> campaign.
  redirectId  String  @unique @map("redirect_id")
  /// Per-ad pixel conversion event (D10), default 'search'.
  pxeEvent    String  @default("search") @map("pxe_event")
  /// Selected pixel — scalar ref to fb_pixels, validated in the service layer.
  pixelId     String? @map("pixel_id") @db.Uuid
  fallbackUrl String? @map("fallback_url")
  beneficiary String?

  fbAdId    String?  @map("fb_ad_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adSet  AdSet   @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  upload Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([adSetId])
  @@map("ads")
}

/// An uploaded creative asset (image/video) stored on disk under UPLOAD_DIR.
model Upload {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  buyerId    String         @map("buyer_id") @db.Uuid
  kind       AdCreativeType
  filename   String
  mimeType   String         @map("mime_type")
  sizeBytes  Int            @map("size_bytes")
  storageKey String         @unique @map("storage_key")
  width      Int?
  height     Int?
  createdAt  DateTime       @default(now()) @map("created_at")

  ads Ad[]

  @@index([orgId])
  @@map("uploads")
}
