// KNN Search Arbitrage Platform — Prisma schema.
// Phase 1 adds multi-tenancy (organizations + users + auth) with Postgres RLS.
// Later phases add campaigns, adsets, ads, channels, articles, revenue, etc.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  SUPER_ADMIN
  COMPANY_ADMIN
  MEDIA_BUYER
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum FbConnectionStatus {
  ACTIVE
  CONNECTION_BROKEN
}

/// A tenant company. The platform operator (KNN) is the single `isPlatform` org
/// that SUPER_ADMINs belong to; every other org is a client company.
model Organization {
  id                   String    @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String    @unique
  status               OrgStatus @default(ACTIVE)
  isPlatform           Boolean   @default(false) @map("is_platform")
  /// Approval mode (D-Phase4): when true, submitted campaigns skip manual review
  /// and go straight to APPROVED. Default is manual review.
  autoApprove          Boolean   @default(false) @map("auto_approve")
  /// Launch mode (D-Phase8): when true, a campaign auto-launches to Facebook as
  /// soon as it has a channel; default is a manual launch gate (admin triggers).
  autoLaunch           Boolean   @default(false) @map("auto_launch")
  /// Platform's default revenue cut for this org's buyers (0..1). New companies default to 10%.
  defaultRevenueCutPct Decimal   @default(0.10) @map("default_revenue_cut_pct") @db.Decimal(5, 4)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  users        User[]
  campaigns    Campaign[]
  ownedDomains Domain[]   @relation("DomainOwner")

  @@map("organizations")
}

/// Facebook tester-onboarding state. Both FB apps are in Development mode, so every buyer must be
/// added as a Tester on both before they can connect. NONE = not started; REQUESTED = buyer submitted
/// their FB profile; INVITED = a super-admin added them in the FB dashboard (awaiting the buyer's
/// approval). "Connected" is derived from having an FbConnection — not a status value here.
enum FbAccessStatus {
  NONE
  REQUESTED
  INVITED
}

model User {
  id            String      @id @default(uuid()) @db.Uuid
  orgId         String      @map("org_id") @db.Uuid
  email         String      @unique
  passwordHash  String      @map("password_hash")
  name          String
  role          Role        @default(MEDIA_BUYER)
  status        UserStatus  @default(PENDING)
  /// FB tester onboarding (apps in Dev mode): the buyer's Facebook profile URL/username + where they
  /// are in the add-as-tester flow (see FbAccessStatus).
  fbHandle       String?        @map("fb_handle")
  fbAccessStatus FbAccessStatus @default(NONE) @map("fb_access_status")
  /// Optional per-buyer override of the org's default revenue cut (0..1).
  revenueCutPct Decimal?    @map("revenue_cut_pct") @db.Decimal(5, 4)
  /// Account-level fallback URL for non-ad traffic (spec §5.7.5).
  fallbackUrl   String?     @map("fallback_url")
  approvedById  String?     @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?   @map("approved_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  organization  Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  fbConnections FbConnection[]
  campaigns     Campaign[]

  @@index([orgId, status])
  @@map("users")
}

/// A media buyer's connected Facebook account (one per user). The long-lived
/// user access token (~60d) is stored encrypted at rest (AES-256-GCM).
model FbConnection {
  id             String             @id @default(uuid()) @db.Uuid
  orgId          String             @map("org_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  fbUserId       String             @map("fb_user_id")
  /// The Facebook profile's display name (from /me). Shown in the UI; one user
  /// may connect several profiles, so this is how they're identified.
  fbName         String?            @map("fb_name")
  /// Which FB app issued this token: "DATA" (default — long-lived, sync/reads/CAPI/refresh)
  /// or "LAUNCH" (short-lived, used ONLY to create/modify ads, to dodge the 31/3858385
  /// checkpoint). A person can hold BOTH for the same FB profile (#two-app, temporary).
  appKind        String             @default("DATA") @map("app_kind")
  accessTokenEnc String             @map("access_token_enc")
  tokenExpiresAt DateTime           @map("token_expires_at")
  scopes         String             @default("")
  status         FbConnectionStatus @default(ACTIVE)
  lastError      String?            @map("last_error")
  connectedAt    DateTime           @default(now()) @map("connected_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccounts FbAdAccount[]
  pages      FbPage[]

  // One row per (user, FB profile, app): a user can connect multiple profiles, and the
  // same profile under both the DATA and LAUNCH apps; reconnecting the same (profile, app)
  // updates the existing row (no duplicates).
  @@unique([userId, fbUserId, appKind])
  @@index([userId])
  @@index([orgId, status])
  @@index([status, tokenExpiresAt])
  @@map("fb_connections")
}

model FbAdAccount {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  fbAccountId  String   @map("fb_account_id")
  name         String
  currency     String
  timezone     String
  status       String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  connection FbConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  pixels     FbPixel[]

  @@unique([connectionId, fbAccountId])
  @@index([orgId])
  @@map("fb_ad_accounts")
}

model FbPage {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  connectionId String   @map("connection_id") @db.Uuid
  fbPageId     String   @map("fb_page_id")
  name         String
  instagramId  String?  @map("instagram_id")
  createdAt    DateTime @default(now()) @map("created_at")

  connection FbConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, fbPageId])
  @@index([orgId])
  @@map("fb_pages")
}

model FbPixel {
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  adAccountId  String   @map("ad_account_id") @db.Uuid
  fbPixelId    String   @map("fb_pixel_id")
  name         String
  landerEvent  String?  @map("lander_event")
  searchEvent  String?  @map("search_event")
  adclickEvent String?  @map("adclick_event")
  createdAt    DateTime @default(now()) @map("created_at")

  adAccount FbAdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, fbPixelId])
  @@index([orgId])
  @@map("fb_pixels")
}

/// Hashed refresh tokens for JWT rotation (access 15m / refresh 7d).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  orgId     String    @map("org_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  userAgent String?   @map("user_agent")
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Append-only audit trail of privileged actions.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String?  @map("org_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([orgId, createdAt])
  @@map("audit_log")
}

/// Global key/value platform settings (compliance prompt, feature toggles, ...).
/// Column names kept as originally migrated (camelCase) to avoid a destructive
/// rename of already-seeded rows.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("platform_settings")
}

// ---------------------------------------------------------------------------
// Phase 3 — Ad launcher. Campaign = the "offer" (D5/D6/D7): keywords, RAC, the
// single article, and the AdSense channel live at CAMPAIGN level. FB structure:
// Campaign → Ad Set (audience/placements/budget + pixel & conversion event) → Ad
// (creative). Per-ad redirect_id (D9); pixel + conversion event (pxe) live at the
// AD-SET level matching Facebook (D10 revised); FB still reports conversions per
// ad, so conversion-weighted revenue (D8) is unaffected.
// ---------------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  LAUNCHING
  ACTIVE
  PAUSED
  REJECTED
  BATCHED
  QUEUED_NO_CHANNEL
  META_REJECTED
  ARCHIVED
}

enum CampaignObjective {
  OUTCOME_SALES
  OUTCOME_LEADS
  OUTCOME_TRAFFIC
  OUTCOME_ENGAGEMENT
  OUTCOME_AWARENESS
  OUTCOME_APP_PROMOTION
}

enum AdCreativeType {
  IMAGE
  VIDEO
}

/// Budget optimization: per-ad-set (ABO) or campaign-level (CBO).
enum BudgetMode {
  AD_SET
  CAMPAIGN
}

model Campaign {
  id               String            @id @default(uuid()) @db.Uuid
  orgId            String            @map("org_id") @db.Uuid
  buyerId          String            @map("buyer_id") @db.Uuid
  name             String
  status           CampaignStatus    @default(DRAFT)
  objective        CampaignObjective @default(OUTCOME_SALES)
  optimizationGoal String            @default("OFFSITE_CONVERSIONS") @map("optimization_goal")

  /// FB Special Ad Categories (empty = none). Required for credit / employment /
  /// housing / social-issue verticals or Facebook rejects the ads.
  specialAdCategories String[] @default([]) @map("special_ad_categories")
  /// Optional name templates with tokens: {country} {query} {language} {id}.
  nameTemplate        String?  @map("name_template")
  adsetNameTemplate   String?  @map("adset_name_template")

  /// Budget optimization. CAMPAIGN (CBO) uses `dailyBudgetCents` here; AD_SET (ABO)
  /// uses each ad set's own budget.
  budgetMode       BudgetMode @default(AD_SET) @map("budget_mode")
  dailyBudgetCents Int?       @map("daily_budget_cents")

  /// Campaign-level offer config (D5): keywords + the landing-page query/angle that drives
  /// article generation (Phase 5) + fallback.
  keywords    Json    @default("[]")
  /// Referrer Ad Creative — campaign-level text sent to Google AFS as `referrerAdCreative`
  /// (the redirect's `rc`; required for paid traffic, shared by all the campaign's ads).
  /// Column kept as `rac_value` (legacy name) to avoid a rename migration.
  racValue    String? @map("rac_value")
  query       String?
  fallbackUrl String? @map("fallback_url")

  /// Selected Facebook assets — scalar refs to fb_* rows, validated in the service
  /// layer (no FK so disconnect-churn of fb assets can't cascade-delete campaigns).
  adAccountId String? @map("ad_account_id") @db.Uuid
  pageId      String? @map("page_id") @db.Uuid

  /// Wired in later phases: article (Phase 5) and AdSense channel (Phase 6).
  articleId String? @map("article_id") @db.Uuid
  channelId String? @map("channel_id") @db.Uuid

  /// Populated on launch (Phase 8).
  fbCampaignId String? @map("fb_campaign_id")

  /// Approval review (Phase 4). `reviewedBy`/`reviewedAt` are set on approve OR
  /// reject (or auto-approval — then `reviewedById` is null = system); a reject
  /// also records `rejectionReason`.
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at")
  rejectionReason String?   @map("rejection_reason")

  submittedAt DateTime? @map("submitted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  buyer        User         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  adSets       AdSet[]
  offers       Offer[]

  @@index([orgId, status])
  @@index([buyerId])
  @@map("campaigns")
}

model AdSet {
  id         String @id @default(uuid()) @db.Uuid
  orgId      String @map("org_id") @db.Uuid
  campaignId String @map("campaign_id") @db.Uuid
  name       String

  /// Daily budget in minor units (cents). Null under campaign budget optimization
  /// (CBO); set per ad set under ABO. Money = integer cents.
  dailyBudgetCents Int?    @map("daily_budget_cents")
  billingEvent     String @default("IMPRESSIONS") @map("billing_event")
  optimizationGoal String @default("OFFSITE_CONVERSIONS") @map("optimization_goal")
  bidStrategy      String? @map("bid_strategy")

  /// Audience targeting (core): geo, age, gender. ISO-3166 alpha-2 country codes;
  /// genders empty = all. `targeting` keeps any advanced/raw FB spec.
  countries String[] @default([])
  ageMin    Int      @default(18) @map("age_min")
  ageMax    Int      @default(65) @map("age_max")
  genders   String[] @default([])
  targeting Json     @default("{}")

  /// Placements: "automatic" or "manual" (then `placements` lists the platforms).
  placementMode String   @default("automatic") @map("placement_mode")
  placements    String[] @default([])

  /// Conversion tracking lives at the ad-set level (FB model; D10 revised): the pixel +
  /// the MAIN conversion event the ad set optimizes toward. The funnel fires ViewContent
  /// (lander) → AddToCart (search) → Search (adclick); `pxeEvent` is the deepest/money one
  /// (default "adclick" → custom_event_type SEARCH).
  pixelId  String? @map("pixel_id") @db.Uuid
  pxeEvent String  @default("adclick") @map("pxe_event")
  /// Deprecated (kept for back-compat; no longer surfaced in the UI or sent to Facebook).
  conversionType String @default("instant") @map("conversion_type")

  /// Additional targeting (parity): exclusions, language, device/OS, Advantage+.
  excludeCountries  String[] @default([]) @map("exclude_countries")
  languages         String[] @default([])
  devicePlatforms   String[] @default([]) @map("device_platforms")
  mobileOs          String[] @default([]) @map("mobile_os")
  advantageAudience Boolean  @default(false) @map("advantage_audience")

  /// Optimization knobs.
  costCapCents      Int?     @map("cost_cap_cents")
  roasFactor        Decimal? @map("roas_factor") @db.Decimal(8, 2)
  attributionWindow String?  @map("attribution_window")

  startTime DateTime? @map("start_time")
  endTime   DateTime? @map("end_time")
  timezone  String?
  fbAdSetId String?   @map("fb_ad_set_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads      Ad[]

  @@index([orgId])
  @@index([campaignId])
  @@map("ad_sets")
}

model Ad {
  id           String         @id @default(uuid()) @db.Uuid
  orgId        String         @map("org_id") @db.Uuid
  adSetId      String         @map("ad_set_id") @db.Uuid
  name         String
  /// Creative.
  headline     String
  primaryText  String         @map("primary_text")
  description  String?
  cta          String         @default("LEARN_MORE")
  /// Optional display link — the visible URL caption shown in the ad (FB link_data.caption),
  /// independent of the cloaked /go/{redirectId} destination. Domain or URL; null = FB derives
  /// the display URL from the destination domain (prior behavior).
  displayLink  String?        @map("display_link")
  creativeType AdCreativeType @default(IMAGE) @map("creative_type")
  uploadId     String?        @map("upload_id") @db.Uuid

  /// Per-ad cloaked redirect (D9) — unique link FB targets; resolves ad -> campaign.
  /// (Pixel + conversion event are on the ad set, not here — D10 revised.)
  redirectId  String  @unique @map("redirect_id")
  fallbackUrl String? @map("fallback_url")
  beneficiary String?

  fbAdId    String?  @map("fb_ad_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  adSet  AdSet   @relation(fields: [adSetId], references: [id], onDelete: Cascade)
  upload Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([adSetId])
  @@map("ads")
}

/// An uploaded creative asset (image/video) stored on disk under UPLOAD_DIR.
model Upload {
  id         String         @id @default(uuid()) @db.Uuid
  orgId      String         @map("org_id") @db.Uuid
  buyerId    String         @map("buyer_id") @db.Uuid
  kind       AdCreativeType
  filename   String
  mimeType   String         @map("mime_type")
  sizeBytes  Int            @map("size_bytes")
  storageKey String         @unique @map("storage_key")
  width      Int?
  height     Int?
  createdAt  DateTime       @default(now()) @map("created_at")

  ads Ad[]

  @@index([orgId])
  @@map("uploads")
}

// ---------------------------------------------------------------------------
// Phase 5 — Article engine (D16). One article per campaign by reference
// (Campaign.articleId), but reusable across a tenant's campaigns when the
// keyword embedding is similar enough (cosine >= ARTICLE_SIMILARITY_THRESHOLD).
// Both the raw Claude output and the compliance-rewritten version are stored
// (audit); the compliant version is what the article frontend serves.
// ---------------------------------------------------------------------------

enum ArticleStatus {
  GENERATING
  READY
  FAILED
}

model Article {
  id    String @id @default(uuid()) @db.Uuid
  orgId String @map("org_id") @db.Uuid

  /// Public URL slug (articles.<domain>/<slug>).
  slug     String @unique
  title    String
  keywords Json   @default("[]")
  /// AI-generated high-commercial-intent related-search queries (Phase 9.5): the
  /// `terms` hint fed to the content-page CSA unit (distinct from campaign keywords;
  /// this is where the high-CPC monetization lives). Empty falls back to `keywords`.
  relatedSearchTerms String[] @default([]) @map("related_search_terms")
  /// The query/angle that drove generation (D6).
  query    String?

  rawContent       String @map("raw_content")
  compliantContent String @map("compliant_content")

  /// 1536-dim OpenAI embedding (text-embedding-3-small) of the keywords/query.
  /// pgvector type — Prisma can't read/write it through the client, so the
  /// embedding is set + queried via raw SQL (cosine `<=>`, ivfflat index).
  embedding Unsupported("vector(1536)")?

  status ArticleStatus @default(READY)
  /// The Claude model that generated it (audit).
  model     String?
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([orgId])
  @@map("articles")
}

/// A saved ad-launcher configuration (a reusable campaign draft, minus creatives).
/// `config` holds the serialized draft so a buyer can spin up similar campaigns fast.
model LauncherPreset {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  buyerId   String   @map("buyer_id") @db.Uuid
  name      String
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([orgId])
  @@map("launcher_presets")
}

// ---------------------------------------------------------------------------
// Phase 6 — Channel pool & assignment (D7/D11). A global pool of AdSense AFS
// custom channels (the `ch` value passed to CSA). One channel ↔ one campaign at a
// time; assigned at approval via `SELECT … FOR UPDATE SKIP LOCKED` (zero double-
// assignment under concurrency). Channels are a PLATFORM resource (no org_id / no
// RLS — like platform_settings); the per-campaign attribution + the FIFO wait
// queue are org-scoped (RLS). Time is the IST business day (D4).
// ---------------------------------------------------------------------------

enum ChannelStatus {
  AVAILABLE
  ASSIGNED
  RESERVED
}

enum QueueStatus {
  WAITING
  ASSIGNED
  CANCELLED
}

model Channel {
  id String @id @default(uuid()) @db.Uuid
  /// The AdSense custom-channel id (the `ch` value); unique across the pool.
  channelId         String        @unique @map("channel_id")
  label             String?
  status            ChannelStatus @default(AVAILABLE)
  /// The campaign currently holding this channel (null when AVAILABLE).
  currentCampaignId String?       @map("current_campaign_id") @db.Uuid
  /// The Domain (website) whose allocation this channel belongs to (Phase A). Null for
  /// legacy/global channels; populated as channels are imported per-domain.
  domainId          String?       @map("domain_id") @db.Uuid
  /// IST business day (YYYY-MM-DD) the current assignment is locked for.
  lockedForDay      String?       @map("locked_for_day")
  assignedAt        DateTime?     @map("assigned_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([domainId])
  @@map("channels")
}

/// Assignment record (also the per-campaign revenue-attribution span for Phase 9):
/// active while `releasedAt` is null, history once released.
model ChannelAssignment {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  channelRef String    @map("channel_ref") @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  /// IST business day the assignment started.
  forDay     String    @map("for_day")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  releasedAt DateTime? @map("released_at")

  @@index([campaignId])
  @@index([channelRef, releasedAt])
  @@index([orgId, forDay])
  @@map("channel_assignments")
}

/// FIFO queue of approved campaigns waiting for a free channel (QUEUED_NO_CHANNEL).
/// Global FIFO order is by `enqueuedAt` across all orgs (single shared pool).
model CampaignQueue {
  id         String      @id @default(uuid()) @db.Uuid
  orgId      String      @map("org_id") @db.Uuid
  campaignId String      @unique @map("campaign_id") @db.Uuid
  status     QueueStatus @default(WAITING)
  enqueuedAt DateTime    @default(now()) @map("enqueued_at")
  assignedAt DateTime?   @map("assigned_at")

  @@index([status, enqueuedAt])
  @@map("campaign_queue")
}

// ---------------------------------------------------------------------------
// Phase 9 — Stats & revenue aggregation (D8/D15). FB insights per ad and AdSense
// revenue per channel are pulled (hourly cron) into per-IST-day rows, then the
// campaign's gross AFS revenue is split across its ads by conversion share (D8,
// largest-remainder) with a zero-conversion fallback (OPEN_QUESTIONS #1:
// conversions → clicks → impressions → campaign-level "unallocated"). All money is
// integer minor units; native amounts pair with a USD field (D15) via the daily
// FxRate. The IST business day (D4) is the bucket key. Storage is DAILY (not the
// plan's "ad_stats_hourly") — attribution + AFS reporting are daily and FB's hourly
// breakdown is timezone-fragile; the cron PULLS hourly to keep "today" fresh.
// ---------------------------------------------------------------------------

/// Daily native-currency → USD rate (GLOBAL: no org_id / no RLS, like channels &
/// platform_settings). `rate` = USD per 1 unit of `currency` on `day`; USD→USD = 1.
model FxRate {
  id        String   @id @default(uuid()) @db.Uuid
  day       String
  currency  String
  rate      Decimal  @db.Decimal(20, 10)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([day, currency])
  @@map("fx_rates")
}

/// Per-ad per-IST-day Facebook insights — the cost side + the D8 conversion signal.
/// Refreshed by the hourly stats cron (idempotent upsert); re-pulled over the FB
/// finalization window (FINALIZATION.FB_REPULL_DAYS) until `finalized`. Spend is the
/// ad account's native currency (minor units) paired with a USD conversion (D15).
model AdStatsDaily {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  adId          String   @map("ad_id") @db.Uuid
  campaignId    String   @map("campaign_id") @db.Uuid
  day           String
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  conversions   Int      @default(0)
  spendMinor    Int      @default(0) @map("spend_minor")
  spendUsdMinor Int      @default(0) @map("spend_usd_minor")
  currency      String   @default("USD")
  finalized     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([adId, day])
  @@index([orgId, day])
  @@index([campaignId, day])
  @@map("ad_stats_daily")
}

/// Per-ad daily FB cost stats broken down by a dimension (country / hour) for the
/// Analytics drill-down. Cost + the conversion signal come from FB's breakdown
/// insights; revenue is NOT dimensioned (AdSense AFS has no geo/hour), so the read
/// layer allocates campaign revenue across buckets by conversion share (D8-style).
model AdStatDimDaily {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  adId             String   @map("ad_id") @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  day              String
  /// 'country' | 'hour'
  dim              String
  /// The bucket value: an ISO country code ("US") or FB hour bucket ("06:00:00 - 06:59:59").
  dimValue         String   @map("dim_value")
  impressions      Int      @default(0)
  clicks           Int      @default(0)
  conversions      Int      @default(0)
  spendMinor       Int      @default(0) @map("spend_minor")
  spendUsdMinor    Int      @default(0) @map("spend_usd_minor")
  currency         String   @default("USD")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([adId, day, dim, dimValue])
  @@index([campaignId, dim, day])
  @@index([orgId])
  @@map("ad_stats_dim_daily")
}

/// Per-campaign per-IST-day gross AdSense revenue — the AFS source of truth. One
/// channel ↔ one campaign per day (D7), so AdSense per-channel revenue maps to the
/// campaign holding that channel on `day` (ChannelAssignment.for_day). Native (AdSense
/// account currency) paired with USD (D15). `afs_clicks < threshold` → `suppressed`
/// (hidden from buyer display, spec §5.8.2). Re-pulled over ADSENSE_REPULL_DAYS.
model CampaignRevenueDaily {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  campaignId      String   @map("campaign_id") @db.Uuid
  channelRef      String   @map("channel_ref") @db.Uuid
  day             String
  afsClicks       Int      @default(0) @map("afs_clicks")
  revenueMinor    Int      @default(0) @map("revenue_minor")
  revenueUsdMinor Int      @default(0) @map("revenue_usd_minor")
  currency        String   @default("USD")
  /// AFS fill-rate counts (RSOC observe-only, summed across the campaign's channels):
  /// fill rate = afsMatchedRequests / afsRequests ("coverage"). 0 when AFS doesn't report them.
  afsRequests        Int   @default(0) @map("afs_requests")
  afsMatchedRequests Int   @default(0) @map("afs_matched_requests")
  afsImpressions     Int   @default(0) @map("afs_impressions")
  suppressed      Boolean  @default(false)
  finalized       Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([campaignId, day])
  @@index([orgId, day])
  @@map("campaign_revenue_daily")
}

/// Derived per-ad per-IST-day revenue: the campaign's gross USD revenue split across
/// its ads by conversion share (D8) with the OPEN_QUESTIONS #1 fallback. The platform
/// revenue cut (User.revenueCutPct ?? Organization.defaultRevenueCutPct) splits the
/// allocated amount into buyer-visible + platform margin. `basis` = what drove the
/// split (conversions | clicks | impressions | unallocated). Recomputed idempotently
/// whenever the campaign's stats/revenue change.
model AdRevenueDaily {
  id                String   @id @default(uuid()) @db.Uuid
  orgId             String   @map("org_id") @db.Uuid
  adId              String   @map("ad_id") @db.Uuid
  campaignId        String   @map("campaign_id") @db.Uuid
  day               String
  conversions       Int      @default(0)
  allocatedUsdMinor Int      @default(0) @map("allocated_usd_minor")
  visibleUsdMinor   Int      @default(0) @map("visible_usd_minor")
  marginUsdMinor    Int      @default(0) @map("margin_usd_minor")
  basis             String   @default("conversions")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([adId, day])
  @@index([orgId, day])
  @@index([campaignId, day])
  @@map("ad_revenue_daily")
}

/// Per-offer per-IST-day AFS revenue (Phase F). With Phase-E offers a campaign holds
/// MANY channels (one per offer, each from its website's AFS account), so per-offer
/// revenue lives here; `campaign_revenue_daily` is the sum across the campaign's offers.
/// Native (the offer's AFS account currency) paired with USD (D15); `afs_clicks <
/// threshold` → `suppressed`. Scalar refs (no FK, like the other revenue tables).
/// Org-scoped (RLS). Drives per-offer ROI (cost is campaign-level FB spend).
model OfferRevenueDaily {
  id              String   @id @default(uuid()) @db.Uuid
  orgId           String   @map("org_id") @db.Uuid
  offerId         String   @map("offer_id") @db.Uuid
  campaignId      String   @map("campaign_id") @db.Uuid
  channelRef      String   @map("channel_ref") @db.Uuid
  day             String
  afsClicks       Int      @default(0) @map("afs_clicks")
  revenueMinor    Int      @default(0) @map("revenue_minor")
  revenueUsdMinor Int      @default(0) @map("revenue_usd_minor")
  currency        String   @default("USD")
  /// Per-offer (= per-channel) AFS fill-rate counts (RSOC observe-only): fill rate =
  /// afsMatchedRequests / afsRequests. 0 when AFS doesn't report them.
  afsRequests        Int   @default(0) @map("afs_requests")
  afsMatchedRequests Int   @default(0) @map("afs_matched_requests")
  afsImpressions     Int   @default(0) @map("afs_impressions")
  suppressed      Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([offerId, day])
  @@index([orgId, day])
  @@index([campaignId, day])
  @@map("offer_revenue_daily")
}

/// Per-term RSOC telemetry (observe-only). AdSense reports have NO per-query/term dimension, so
/// the only place term-level performance is observable is the client: when a visitor clicks a
/// related-search chip and lands on /search?q=<term>, the page beacons whether Google served ads
/// for that term (fill) and whether an ad was clicked. Aggregated per term per IST business day.
/// This is the term-grain "monitor partner terms" signal Google's RSOC quality guidance recommends
/// (a term whose searches climb while fills stay flat = no good ad inventory → a candidate to drop).
/// Platform-wide (no org scope — terms recur across articles); super-admin visibility only.
/// Self-dormant: with no client telemetry URL configured, nothing is ever written.
model TermStatDaily {
  id        String   @id @default(uuid()) @db.Uuid
  term      String
  day       String
  searches  Int      @default(0)
  fills     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([term, day])
  @@index([day])
  @@map("term_stat_daily")
}

/// Cloaker decision telemetry (observe-first ad-ID verification). The edge redirect beacons every
/// decision so we can SEE the money-vs-white split — and, before enforcing, whether real ad clicks
/// carry the FB `{{ad.id}}` macro. `money`/`white` = where the click was actually routed. For PAID
/// clicks we also record the would-be-enforce outcome: `verifiedMatch` (kaid == expected ad id),
/// `verifiedMismatch` (kaid present but wrong → spoof/bot, safe to block), `macroMissing` (paid but
/// no kaid → enforcing would white-page these = the revenue-loss signal to watch). Per campaign per
/// IST day; platform-wide (super-admin visibility). Self-dormant: nothing writes unless the worker
/// has a telemetry URL configured.
model CloakStatDaily {
  id               String   @id @default(uuid()) @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  day              String
  money            Int      @default(0)
  white            Int      @default(0)
  verifiedMatch    Int      @default(0) @map("verified_match")
  verifiedMismatch Int      @default(0) @map("verified_mismatch")
  macroMissing     Int      @default(0) @map("macro_missing")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([campaignId, day])
  @@index([day])
  @@map("cloak_stat_daily")
}

// ---------------------------------------------------------------------------
// Conversion tracking (RSOC final ad-click → Facebook Conversions API, S2S).
// The AFS ad lives in a cross-origin Google iframe, so the client can't see the
// click directly — the /search page infers it (postMessage from syndicatedsearch.goog
// + the iframe being the active element) and beacons /api/events with the click id
// (our `txid`). The server resolves that click → the ad's pixel + the owning buyer's
// token, records a ConversionEvent, and a worker fires it to FB CAPI (deduped on
// `clickId` via `event_id`). The transient click→ad/fbclid map lives in edge KV
// (`click:{txid}`); this row is the durable record + the first-party conversion signal.
// ---------------------------------------------------------------------------

/// One row per converting click (one final ad-click per click id). `clickId` = the
/// redirect `txid`; unique so a click converts at most once. Resolved server-side from
/// the click → never trusts the client for the pixel/token.
model ConversionEvent {
  id             String    @id @default(uuid()) @db.Uuid
  orgId          String    @map("org_id") @db.Uuid
  campaignId     String    @map("campaign_id") @db.Uuid
  adId           String    @map("ad_id") @db.Uuid
  /// The redirect click id (txid) — the join key + FB CAPI `event_id` basis (dedup).
  /// One click can fire several funnel events (ViewContent/AddToCart/Search), so the
  /// uniqueness is on (clickId, eventName), not clickId alone (see @@unique below).
  clickId        String    @map("click_id")
  /// Facebook click id (from the original /go click) → builds `fbc` for attribution.
  fbclid         String?
  /// Resolved at ingest: the FB pixel id (from the ad set) + the matching event name.
  pixelFbId      String    @map("pixel_fb_id")
  eventName      String    @map("event_name")
  /// Optional conversion value (minor units) + currency for value optimization.
  valueMinor     Int?      @map("value_minor")
  currency       String    @default("USD")
  /// Captured at the conversion beacon for CAPI user_data (the user's request).
  clientIp       String?   @map("client_ip")
  clientUa       String?   @map("client_ua")
  eventSourceUrl String?   @map("event_source_url")
  /// When the conversion happened (used as CAPI event_time + fbc timestamp basis).
  eventTime      DateTime  @map("event_time")
  /// pending → sent (CAPI 200) | failed (exhausted retries).
  status         String    @default("pending")
  attempts       Int       @default(0)
  fbResponse     String?   @map("fb_response")
  sentAt         DateTime? @map("sent_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([clickId, eventName])
  @@index([orgId, createdAt])
  @@index([campaignId, createdAt])
  @@index([status])
  @@map("conversion_events")
}

// ---------------------------------------------------------------------------
// Google / AdSense connection (Phase 10 follow-up). Unlike Facebook (per-buyer),
// AdSense is a SINGLE platform account (the funnel's approved domain), so this is
// a global singleton (no org scope / no RLS — like channels & platform_settings).
// A SUPER_ADMIN connects it; the refresh token (offline access) is AES-256-GCM
// encrypted at rest (same TOKEN_ENCRYPTION_KEY as FbConnection). The worker refreshes
// the short-lived access token on demand and feeds the AdSense revenue pull (D8).
// ---------------------------------------------------------------------------
/// An AFS / AdSense account = a revenue source (the doc's "AfsAccount"). Global (no
/// org scope / no RLS — like channels). The platform can connect SEVERAL (AFS 1/2/3),
/// each with its own AFS pubId + OAuth token. The legacy single row keeps id "platform".
model GoogleConnection {
  id              String   @id @default(uuid())
  /// Human label for the super-admin (e.g. "AFS 1 — Oarex").
  label           String?
  /// The AFS code's pubId for this account (`partner-pub-…`) — what the CSA unit renders.
  afsPubId        String?  @map("afs_pub_id")
  googleEmail     String?  @map("google_email")
  accessTokenEnc  String   @map("access_token_enc")
  refreshTokenEnc String?  @map("refresh_token_enc")
  tokenExpiresAt  DateTime @map("token_expires_at")
  scopes          String   @default("")
  /// AdSense resource ids discovered at connect (e.g. accounts/pub-X, .../adclients/partner-pub-X).
  adsenseAccount  String?  @map("adsense_account")
  adsenseAdClient String?  @map("adsense_ad_client")
  /// DEPRECATED (Phase A): channel allocation moved to the Domain (per-website). Kept
  /// for the legacy single-account flow until Phase C migrates it.
  channelRanges   String?  @map("channel_ranges")
  /// ACTIVE | CONNECTION_BROKEN (string, not the FB enum, to avoid coupling).
  status          String   @default("ACTIVE")
  lastError       String?  @map("last_error")
  connectedById   String?  @map("connected_by_id") @db.Uuid
  connectedAt     DateTime @default(now()) @map("connected_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  domains Domain[]

  @@map("google_connections")
}

/// Local mirror of an AFS account's custom channels (id + name), synced from the AdSense
/// API. An account can hold ~100k channels, so browsing/searching the live API per request
/// is slow — sync once, then search the catalog locally (instant). Selecting from the
/// catalog imports into the usable `channels` pool. Global (no org / RLS — like channels).
model AfsChannelCatalog {
  id           String   @id @default(uuid()) @db.Uuid
  afsAccountId String   @map("afs_account_id")
  /// The AdSense custom-channel id (the `ch` value).
  channelId    String   @map("channel_id")
  displayName  String?  @map("display_name")
  syncedAt     DateTime @default(now()) @map("synced_at")

  @@unique([afsAccountId, channelId])
  @@index([afsAccountId])
  @@map("afs_channel_catalog")
}

enum DomainStatus {
  PENDING_DNS
  VERIFYING
  LIVE
  ERROR
}

/// A monetized article website (the doc's "Domain"). Maps to ONE AFS account → that's
/// the pubId it renders. Has its own channel-id allocation (which ids this site may use).
/// Global (platform-level, super-admin managed; buyers read it to pick offers). No RLS.
model Domain {
  id            String       @id @default(uuid()) @db.Uuid
  host          String       @unique
  afsAccountId  String       @map("afs_account_id")
  /// Channel-id series this website owns (e.g. "09000-09500"); rest are other teams'.
  channelRanges String?      @map("channel_ranges")
  styleId       String?      @map("style_id")
  adsafe        String?
  status        DomainStatus @default(PENDING_DNS)
  /// Token served at /.well-known to prove control on verify.
  verifyToken   String       @map("verify_token")
  verifiedAt    DateTime?    @map("verified_at")
  lastCheck     String?      @map("last_check")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  /// Optional company that owns this domain. NULL = shared (any company's
  /// campaigns may use it); set = only that company's buyers may route offers here.
  ownerOrgId String? @map("owner_org_id") @db.Uuid

  afsAccount GoogleConnection @relation(fields: [afsAccountId], references: [id], onDelete: Cascade)
  ownerOrg   Organization?    @relation("DomainOwner", fields: [ownerOrgId], references: [id], onDelete: SetNull)
  offers     Offer[]

  @@index([afsAccountId])
  @@index([ownerOrgId])
  @@map("domains")
}

/// Platform redirect domains — the `go.*` hosts the Cloudflare redirect Worker serves.
/// The DEFAULT one is what new ad creatives link to (`https://{host}/go/{redirectId}`);
/// the launch pipeline reads it (falling back to env `REDIRECT_DOMAIN`). Distinct from
/// `domains` (article/offer sites). Global (no org_id) — super-admin managed, accessed via
/// withSystem. At most one default (partial unique index in the migration).
model RedirectDomain {
  id         String    @id @default(uuid()) @db.Uuid
  host       String    @unique
  label      String?
  isDefault  Boolean   @default(false) @map("is_default")
  /// Last reachability check, e.g. "ok 200" or "unreachable: …".
  lastCheck  String?   @map("last_check")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("redirect_domains")
}

enum OfferKind {
  PAID
  ORGANIC
}

/// An offer = one destination of a campaign's traffic: a website (→ AFS pubId) + a
/// weight + an assigned channel (from the website's allocation) for revenue attribution.
/// A campaign has many offers (offer testing). Org-scoped (RLS) — it's per-campaign.
model Offer {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  domainId   String    @map("domain_id") @db.Uuid
  weightPct  Int       @default(0) @map("weight_pct")
  kind       OfferKind @default(PAID)
  /// Optional ARTICLE VARIANT for this offer (A/B testing): the article served on this
  /// offer's website. Null → the campaign's default article (Campaign.articleId). Nullable,
  /// no FK (reusable across campaigns, like Campaign.articleId).
  articleId  String?   @map("article_id") @db.Uuid
  /// The Channel (pool row) assigned to this offer for attribution; null until assigned.
  channelRef String?   @map("channel_ref") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  domain   Domain   @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@index([campaignId])
  @@index([orgId])
  @@map("offers")
}
