# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Turbo
.turbo/

# Env files (never commit secrets). Ignore .env and all .env.* (incl. .env.staging),
# but keep the *.example templates tracked.
.env
.env.*
*.env
!.env.example
!.env.*.example

# Prisma
packages/db/prisma/*.db

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test / coverage
coverage/
playwright-report/
test-results/
.vitest/

# Uploads (local creative storage). Root-anchored so it can't swallow source
# directories named "uploads" (e.g. apps/api/src/modules/uploads).
var/uploads/
/uploads/

# Misc
tmp/
*.pid
