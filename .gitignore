# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Turbo
.turbo/

# Env files (never commit secrets). Ignore .env and all .env.* (incl. .env.staging),
# but keep the *.example templates tracked.
.env
.env.*
*.env
!.env.example
!.env.*.example

# Prisma
packages/db/prisma/*.db

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Test / coverage
coverage/
playwright-report/
test-results/
.vitest/

# Uploads (local creative storage). Match the runtime dir at any depth (the API
# test writes to apps/api/var/uploads when cwd is the package). NOT a bare
# `uploads/`, which would swallow source dirs like apps/api/src/modules/uploads.
**/var/uploads/
/uploads/

# Misc
tmp/
*.pid

# Local export artifacts (generated source bundles — not source, never commit)
*.zip
