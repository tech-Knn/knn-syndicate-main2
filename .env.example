# =============================================================================
# KNN Search Arbitrage Platform — environment template
# Copy to `.env` for local dev. Staging/production values are injected by the
# host and NEVER committed. APP_ENV selects the environment profile.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# local | staging | production  (staging uses real FB *test* ad accounts)
APP_ENV=local
LOG_LEVEL=debug

# --- Service ports -----------------------------------------------------------
API_PORT=3000
ARTICLE_PORT=3001
REDIRECT_PORT=3002
WEB_PORT=3003

# --- Domains (used to build OAuth redirects, redirect/article URLs) ----------
PLATFORM_DOMAIN=http://localhost:3000
WEB_DOMAIN=http://localhost:3003
ARTICLE_DOMAIN=http://localhost:3001
REDIRECT_DOMAIN=http://localhost:3002

# --- PostgreSQL (also consumed by docker-compose) ----------------------------
POSTGRES_USER=knn
POSTGRES_PASSWORD=knn_local_dev_pw
POSTGRES_DB=knn
POSTGRES_PORT=5432
DATABASE_URL=postgresql://knn:knn_local_dev_pw@localhost:5432/knn?schema=public
# Shadow DB for Prisma migrations (created/dropped automatically in dev)
SHADOW_DATABASE_URL=postgresql://knn:knn_local_dev_pw@localhost:5432/knn_shadow?schema=public
# App RUNTIME connection — a NON-superuser role so Row-Level Security is enforced.
# Migrations use DATABASE_URL (owner); the app uses this. Created by `pnpm db:bootstrap`.
APP_DATABASE_URL=postgresql://knn_app:knn_app_local_pw@localhost:5432/knn?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth / crypto -----------------------------------------------------------
# Generate strong values for staging/prod: `openssl rand -hex 32`
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_0123456789abcdef
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# AES-256-GCM key for encrypting Facebook tokens at rest. MUST be 64 hex chars (32 bytes).
TOKEN_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# --- Bull-Board (queue dashboard) basic auth ---------------------------------
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin

# --- Facebook Marketing API --------------------------------------------------
FB_APP_ID=
FB_APP_SECRET=
FB_API_VERSION=v21.0
FB_OAUTH_REDIRECT_URI=http://localhost:3000/api/facebook/callback
FB_WEBHOOK_VERIFY_TOKEN=dev_fb_webhook_verify_token
# Facebook Login for Business: set to the login-configuration id to use the
# config_id OAuth flow (leave empty to fall back to classic scope-based login).
FB_LOGIN_CONFIG_ID=

# --- Google AdSense (AFS revenue) --------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/adsense/callback

# --- AI providers ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- FX rates (daily native->USD conversion) ---------------------------------
FX_API_URL=https://api.exchangerate.host
FX_API_KEY=

# --- Storage -----------------------------------------------------------------
UPLOAD_DIR=./var/uploads

# --- Business config ---------------------------------------------------------
# Platform business day for channel rollover & revenue buckets.
BUSINESS_TIMEZONE=Asia/Kolkata
